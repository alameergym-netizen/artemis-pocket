<?xml version="1.0" encoding="utf-8"?>
<!-- Artemis Pocket: dialogs spring forward out of the screen -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <alpha android:interpolator="@interpolator/pocket_emphasized"
        android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="220" />
    <scale android:interpolator="@android:interpolator/overshoot"
        android:fromXScale="0.9" android:toXScale="1.0"
        android:fromYScale="0.9" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" android:duration="380" />
    <translate android:interpolator="@interpolator/pocket_emphasized"
        android:fromYDelta="4%" android:toYDelta="0" android:duration="380" />
</set>
