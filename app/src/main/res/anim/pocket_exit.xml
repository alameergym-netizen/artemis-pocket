<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <alpha android:interpolator="@interpolator/pocket_accelerate"
        android:fromAlpha="1.0" android:toAlpha="0.0" android:duration="200" />
    <scale android:interpolator="@interpolator/pocket_emphasized"
        android:fromXScale="1.0" android:toXScale="1.05"
        android:fromYScale="1.0" android:toYScale="1.05"
        android:pivotX="50%" android:pivotY="50%" android:duration="420" />
</set>
