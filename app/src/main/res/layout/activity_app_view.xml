<?xml version="1.0" encoding="utf-8"?>
<!-- Artemis Pocket: console game library -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pocketRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pocket_bg"
    tools:context=".AppView">

    <com.limelight.pocket.ui.AuroraView
        android:id="@+id/pocketAurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Blurred art of the selected game, cross-faded between two layers -->
    <ImageView
        android:id="@+id/pocketHeroArtA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/pocketHeroArtB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/pocket_hero_scrim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="@drawable/pocket_bottom_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Status bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="28dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pocket_back"
                android:tint="@color/pocket_text_dim" />

            <TextView
                android:id="@+id/appListText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pocket_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/pocketLinkChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pocket_chip_bg"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textColor="@color/pocket_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pocketBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="@color/pocket_text_dim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pocketClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="@color/pocket_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hero -->
        <LinearLayout
            android:id="@+id/pocketHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingTop="12dp"
            android:paddingEnd="36dp">

            <TextView
                android:id="@+id/pocketSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="@string/pocket_library"
                android:textAllCaps="true"
                android:textColor="@color/pocket_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pocketHeroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxWidth="620dp"
                android:maxLines="1"
                android:textColor="@color/pocket_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pocketHeroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/pocket_chip_bg"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="@color/pocket_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Game carousel -->
        <FrameLayout
            android:id="@+id/appFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pocketAppCarousel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:overScrollMode="never"
                android:paddingStart="22dp"
                android:paddingTop="18dp"
                android:paddingEnd="120dp"
                android:paddingBottom="18dp" />
        </FrameLayout>

        <!-- Profile + button hints -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="4dp"
            android:paddingEnd="28dp"
            android:paddingBottom="16dp">

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/profilesButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:contentDescription="@string/profile_manager_choose_profile"
                android:minHeight="46dp"
                android:textColor="@color/pocket_text"
                app:backgroundTint="@color/pocket_surface_high"
                app:elevation="0dp"
                app:icon="@drawable/ic_profiles"
                app:iconTint="@color/pocket_text" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/pocketHintBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
