<?xml version="1.0" encoding="utf-8"?>
<!-- Artemis Pocket: game library (mono glass) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pocketRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pocket_bg"
    tools:context=".AppView">

    <!-- Everything behind the glass: lights, the selected game's art, scrims -->
    <FrameLayout
        android:id="@+id/pocketBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.limelight.pocket.ui.AuroraView
            android:id="@+id/pocketAurora"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Blurred art of the selected game, cross-faded between two layers -->
        <ImageView
            android:id="@+id/pocketHeroArtA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/pocketHeroArtB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <!-- Key art (a SteamGridDB background): sharp across the top, console style. The black
             underlay hides the blurred art while it shows. -->
        <View
            android:id="@+id/pocketKeyArtUnderlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="#FF000000" />

        <FrameLayout
            android:id="@+id/pocketKeyArtFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0">

            <ImageView
                android:id="@+id/pocketKeyArtA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/pocketKeyArtB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:alpha="0"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/pocket_keyart_fade" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/pocket_hero_scrim" />

        <View
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_gravity="bottom"
            android:background="@drawable/pocket_bottom_scrim" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/pocketMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Status bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="22dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pocket_glass_pill"
                android:tag="glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pocket_back"
                    android:tint="@color/pocket_text_dim" />

                <TextView
                    android:id="@+id/appListText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:maxWidth="220dp"
                    android:textColor="@color/pocket_text"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pocket_glass_pill"
                android:tag="glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="3dp"
                android:paddingEnd="12dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/pocketLinkChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pocket_chip_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/pocket_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/pocketBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/pocket_text_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/pocketClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/pocket_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hero -->
        <LinearLayout
            android:id="@+id/pocketHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="10dp"
            android:paddingEnd="28dp">

            <TextView
                android:id="@+id/pocketSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:text="@string/pocket_library"
                android:textAllCaps="true"
                android:textColor="@color/pocket_text_dim"
                android:textSize="9.5sp" />

            <!-- The game's logo (when there is one) takes the place of its name -->
            <ImageView
                android:id="@+id/pocketHeroLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="3dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:maxWidth="340dp"
                android:maxHeight="66dp"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pocketHeroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.025"
                android:maxWidth="520dp"
                android:maxLines="1"
                android:shadowColor="#66000000"
                android:shadowDy="1"
                android:shadowRadius="12"
                android:textColor="@color/pocket_text"
                android:textSize="28sp" />

            <!-- Play, status and playtime on one line (console style) -->
            <LinearLayout
                android:id="@+id/pocketHeroMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Play / Resume: frosted glass tinted with the accent (styled in code) -->
                <TextView
                    android:id="@+id/pocketHeroPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="14dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="5dp"
                    android:tag="glass"
                    android:textColor="#FF000000"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/pocketHeroSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pocket_chip_bg"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="9dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/pocket_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/pocketHeroPlaytime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/pocket_text_dim"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Game carousel -->
        <FrameLayout
            android:id="@+id/appFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <com.limelight.pocket.ui.CarouselRow
                    android:id="@+id/pocketAppCarousel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:overScrollMode="never"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="90dp"
                    android:paddingBottom="14dp" />

                <!-- Where you are in the row -->
                <com.limelight.pocket.ui.RowIndicator
                    android:id="@+id/pocketRowIndicator"
                    android:layout_width="132dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="30dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </FrameLayout>

        <!-- Profile + button hints -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="2dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/profilesButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/pocket_pill_button_bg"
                android:clickable="true"
                android:contentDescription="@string/profile_manager_choose_profile"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:minWidth="34dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:textColor="@color/pocket_row_text"
                android:textSize="11sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/pocketHintBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pocket_glass_pill"
                android:tag="glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
