<?xml version="1.0" encoding="utf-8"?>
<!-- Artemis Pocket: console home screen (mono glass) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pocketRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pocket_bg"
    tools:context=".PcView">


    <com.limelight.pocket.ui.AuroraView
        android:id="@+id/pocketAurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/pocketMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Status bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="12dp"
            android:paddingEnd="22dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pocket_logo" />

            <TextView
                android:id="@+id/pocketBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.22"
                android:text="@string/pocket_brand"
                android:textColor="@color/pocket_text"
                android:textSize="10.5sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pocket_glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="3dp"
                android:paddingEnd="12dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/pocketLinkChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pocket_chip_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/pocket_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/pocketBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/pocket_text_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/pocketClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/pocket_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hero -->
        <LinearLayout
            android:id="@+id/pocketHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="10dp"
            android:paddingEnd="28dp">

            <TextView
                android:id="@+id/pocketSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:text="@string/pocket_my_pcs"
                android:textAllCaps="true"
                android:textColor="@color/pocket_text_dim"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/pocketHeroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:textColor="@color/pocket_text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/pocketHeroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pocket_text_dim"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- PC carousel -->
        <FrameLayout
            android:id="@+id/pcFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pocketPcCarousel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:layoutAnimation="@anim/pocket_stagger"
                android:overScrollMode="never"
                android:paddingStart="22dp"
                android:paddingTop="12dp"
                android:paddingEnd="22dp"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:id="@+id/no_pc_found_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">

                <ProgressBar
                    android:id="@+id/pcs_loading"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/pocket_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/pocket_searching_title"
                    android:textColor="@color/pocket_text"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:maxWidth="400dp"
                    android:text="@string/pocket_searching_sub"
                    android:textColor="@color/pocket_text_dim"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Actions + button hints -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/pocket_icon_button_bg"
                android:contentDescription="@string/pocket_hint_settings"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                android:tint="@color/pocket_icon_tint" />

            <ImageButton
                android:id="@+id/manuallyAddPc"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/pocket_icon_button_bg"
                android:contentDescription="@string/pocket_hint_add_pc"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_add"
                android:tint="@color/pocket_icon_tint" />

            <ImageButton
                android:id="@+id/helpButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/pocket_icon_button_bg"
                android:contentDescription="@string/pocket_usb_help_title"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_help"
                android:tint="@color/pocket_icon_tint" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/profilesButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/profile_manager_choose_profile"
                android:minHeight="34dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/pocket_text"
                android:textSize="11sp"
                app:backgroundTint="#26FFFFFF"
                app:elevation="0dp"
                app:icon="@drawable/ic_profiles"
                app:iconSize="16dp"
                app:iconTint="@color/pocket_text" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/pocketHintBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pocket_glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/pocket_usb_overlay" />

    <include layout="@layout/pocket_splash" />
</FrameLayout>
