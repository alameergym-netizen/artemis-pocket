<?xml version="1.0" encoding="utf-8"?>
<!-- Artemis Pocket: console home screen (mono glass) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pocketRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pocket_bg"
    tools:context=".PcView">


    <!-- Behind the glass: lights, the selected PC's game art, scrims -->
    <FrameLayout
        android:id="@+id/pocketBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.limelight.pocket.ui.AuroraView
            android:id="@+id/pocketAurora"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/pocketHeroArtA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/pocketHeroArtB"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <!-- The selected game's key art, sharp across the top (like the library) -->
        <View
            android:id="@+id/pocketKeyArtUnderlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="#FF000000" />

        <!-- Key art across the whole screen; each layer fades itself out (KeyArtView) -->
        <FrameLayout
            android:id="@+id/pocketKeyArtFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0">

            <com.limelight.pocket.ui.KeyArtView
                android:id="@+id/pocketKeyArtA"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.limelight.pocket.ui.KeyArtView
                android:id="@+id/pocketKeyArtB"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0" />
        </FrameLayout>

        <View
            android:id="@+id/pocketHeroScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/pocket_hero_scrim" />

        <View
            android:id="@+id/pocketBottomScrim"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_gravity="bottom"
            android:background="@drawable/pocket_bottom_scrim" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/pocketMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Status bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:minHeight="26dp"
            android:layout_marginTop="10dp"
            android:paddingStart="14dp"
            android:paddingEnd="18dp">

            <ImageView
                android:id="@+id/pocketBrandLogo"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pocket_mark" />

            <TextView
                android:id="@+id/pocketBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.22"
                android:text="@string/pocket_brand"
                android:textColor="@color/pocket_text"
                android:textSize="10.5sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp">

                <TextView
                    android:id="@+id/pocketLinkChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center_vertical"
                    android:textColor="@color/pocket_text"
                    android:textSize="11sp"
                    android:shadowColor="#99000000"
                    android:shadowRadius="8" />

                <TextView
                    android:id="@+id/pocketBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/pocket_text"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter_medium"
                    android:shadowColor="#99000000"
                    android:shadowRadius="8" />

                <TextView
                    android:id="@+id/pocketClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/pocket_text"
                    android:textSize="12.5sp"
                    android:letterSpacing="-0.01"
                    android:shadowColor="#99000000"
                    android:shadowRadius="8" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hero -->
        <LinearLayout
            android:id="@+id/pocketHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="34dp"
            android:paddingEnd="28dp">

            <TextView
                android:id="@+id/pocketSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:shadowColor="#80000000"
                android:shadowRadius="8"
                android:text="@string/pocket_my_pcs"
                android:textColor="#B8FFFFFF"
                android:textSize="10sp" />

            <!-- A game's logo (when there is one) takes the place of its name -->
            <com.limelight.pocket.ui.LogoView
                android:id="@+id/pocketHeroLogo"
                android:layout_width="340dp"
                android:layout_height="66dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="3dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pocketHeroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="-0.028"
                android:maxLines="1"
                android:shadowColor="#66000000"
                android:shadowDy="1"
                android:shadowRadius="12"
                android:textColor="@color/pocket_text"
                android:textSize="28sp" />

            <!-- What A does, the PC's state, and what it played last (console style) -->
            <LinearLayout
                android:id="@+id/pocketHeroMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Play / Resume: frosted glass tinted with the accent (styled in code) -->
                <TextView
                    android:id="@+id/pocketHeroPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="@font/inter_medium"
                    android:paddingStart="14dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="5dp"
                    android:textColor="#FF000000"
                    android:textSize="12.5sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/pocketHeroSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/pocket_text_dim"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/pocketHeroPlaytime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pocket_text_faint"
                android:textSize="10.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- PC carousel -->
        <FrameLayout
            android:id="@+id/pcFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Your PCs, then the games played last on the focused one (console home row) -->
            <LinearLayout
                android:id="@+id/pocketHomeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pocketPcCarousel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:overScrollMode="never"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="14dp" />

                <!-- Starts with a section gap (with a hairline in it); its cards fade out there
                     as they scroll away instead of sliding over the PC card -->
                <com.limelight.pocket.ui.CarouselRow
                    android:id="@+id/pocketRecentCarousel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:overScrollMode="never"
                    android:paddingStart="28dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="90dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/no_pc_found_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">

                <com.limelight.pocket.ui.PulseRingsView
                    android:id="@+id/pcs_loading"
                    android:layout_width="72dp"
                    android:layout_height="72dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="@string/pocket_searching_title"
                    android:textColor="@color/pocket_text"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:maxWidth="400dp"
                    android:text="@string/pocket_searching_sub"
                    android:textColor="@color/pocket_text_dim"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Actions + button hints -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="9dp">

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/pocket_icon_button_bg"
                android:contentDescription="@string/pocket_hint_settings"
                android:padding="7.5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                android:tint="@color/pocket_icon_tint" />

            <ImageButton
                android:id="@+id/manuallyAddPc"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/pocket_icon_button_bg"
                android:contentDescription="@string/pocket_hint_add_pc"
                android:padding="7.5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_add"
                android:tint="@color/pocket_icon_tint" />

            <ImageButton
                android:id="@+id/helpButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/pocket_icon_button_bg"
                android:contentDescription="@string/pocket_usb_help_title"
                android:padding="7.5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_help"
                android:tint="@color/pocket_icon_tint" />

            <!-- Pocket Nexus: the handheld's own apps, games and emulators -->
            <ImageButton
                android:id="@+id/pocketAppsButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/pocket_icon_button_bg"
                android:contentDescription="@string/pocket_apps_title"
                android:padding="7.5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pocket_apps"
                android:tint="@color/pocket_icon_tint" />

            <TextView
                android:id="@+id/profilesButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/pocket_pill_button_bg"
                android:clickable="true"
                android:contentDescription="@string/profile_manager_choose_profile"
                android:focusable="true"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:maxLines="1"
                android:minWidth="30dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:textColor="@color/pocket_row_text"
                android:textSize="11sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/pocketHintBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/pocket_usb_overlay" />
</FrameLayout>
