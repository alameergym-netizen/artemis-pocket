<?xml version="1.0" encoding="utf-8"?>
<!-- Artemis Pocket: console home screen -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pocketRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pocket_bg"
    tools:context=".PcView">

    <com.limelight.pocket.ui.AuroraView
        android:id="@+id/pocketAurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Status bar -->
        <LinearLayout
            android:id="@+id/pocketTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingTop="16dp"
            android:paddingEnd="28dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/pocketBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:letterSpacing="0.18"
                android:text="@string/pocket_brand"
                android:textColor="@color/pocket_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/pocketLinkChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pocket_chip_bg"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textColor="@color/pocket_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pocketBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="@color/pocket_text_dim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pocketClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="@color/pocket_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hero -->
        <LinearLayout
            android:id="@+id/pocketHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingTop="14dp"
            android:paddingEnd="36dp">

            <TextView
                android:id="@+id/pocketSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="@string/pocket_my_pcs"
                android:textAllCaps="true"
                android:textColor="@color/pocket_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pocketHeroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pocket_text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pocketHeroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pocket_text_dim"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- PC carousel -->
        <FrameLayout
            android:id="@+id/pcFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pocketPcCarousel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:overScrollMode="never"
                android:paddingStart="28dp"
                android:paddingTop="16dp"
                android:paddingEnd="28dp"
                android:paddingBottom="16dp" />

            <LinearLayout
                android:id="@+id/no_pc_found_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingEnd="32dp">

                <ProgressBar
                    android:id="@+id/pcs_loading"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/pocket_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/pocket_searching_title"
                    android:textColor="@color/pocket_text"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxWidth="480dp"
                    android:text="@string/pocket_searching_sub"
                    android:textColor="@color/pocket_text_dim"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Actions + button hints -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="6dp"
            android:paddingEnd="28dp"
            android:paddingBottom="16dp">

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/pocket_icon_button_bg"
                android:contentDescription="@string/pocket_hint_settings"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                android:tint="@color/pocket_icon_tint" />

            <ImageButton
                android:id="@+id/manuallyAddPc"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/pocket_icon_button_bg"
                android:contentDescription="@string/pocket_hint_add_pc"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_add"
                android:tint="@color/pocket_icon_tint" />

            <ImageButton
                android:id="@+id/helpButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/pocket_icon_button_bg"
                android:contentDescription="@string/pocket_usb_help_title"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_help"
                android:tint="@color/pocket_icon_tint" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/profilesButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/profile_manager_choose_profile"
                android:minHeight="46dp"
                android:textColor="@color/pocket_text"
                app:backgroundTint="@color/pocket_surface_high"
                app:elevation="0dp"
                app:icon="@drawable/ic_profiles"
                app:iconTint="@color/pocket_text" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/pocketHintBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/pocket_usb_overlay" />
</FrameLayout>
