<?xml version="1.0" encoding="utf-8"?>
<!-- Artemis Pocket: glass PC card. IDs grid_* are used by the upstream adapter. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="150dp"
    android:layout_height="164dp"
    android:background="@drawable/pocket_card_bg">

    <!-- The game it is playing / played last, when there is art for it -->
    <ImageView
        android:id="@+id/pc_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/pc_art_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/pocket_pc_art_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/grid_image_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/grid_image"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:tint="@color/pocket_text" />

            <ImageView
                android:id="@+id/pc_badge"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|start"
                android:background="@drawable/pocket_badge_bg"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/pocket_text"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/grid_overlay"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:importantForAccessibility="no"
                android:tint="@color/pocket_text" />

            <ProgressBar
                android:id="@+id/grid_spinner"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:indeterminate="true"
                android:indeterminateTint="@color/pocket_text" />
        </FrameLayout>

        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/pocket_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/pc_status_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/pocket_dot" />

            <TextView
                android:id="@+id/pc_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pocket_text_dim"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
