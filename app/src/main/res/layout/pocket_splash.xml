<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start logo reveal -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pocketSplash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pocket_bg"
    android:clickable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/pocketSplashLogo"
            android:layout_width="112dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pocket_logo" />

        <TextView
            android:id="@+id/pocketSplashText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.45"
            android:text="@string/pocket_brand"
            android:textColor="@color/pocket_text"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
